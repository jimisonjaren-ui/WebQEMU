#!/bin/sh
# WebQEMU desktop guest boot script (BusyBox init sysinit action).
mkdir -p /dev/pts /dev/shm /run /tmp /proc /sys
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /dev/shm
chmod 1777 /tmp /dev/shm
echo "[rcS] system mounts complete"

# No udev here: give the input devices stable names by looking them up in /proc.
mkdir -p /dev/input/by-name
find_ev() {
  awk -v RS= -v pat="$1" '$0 ~ pat { if (match($0, /event[0-9]+/)) { print substr($0, RSTART, RLENGTH); exit } }' /proc/bus/input/devices
}
KBD=$(find_ev 'AT Translated Set 2 keyboard')
TAB=$(find_ev 'QEMU Virtio Tablet')
[ -n "$KBD" ] && ln -sf "/dev/input/$KBD" /dev/input/by-name/kbd
[ -n "$TAB" ] && ln -sf "/dev/input/$TAB" /dev/input/by-name/tablet
echo "[rcS] input: kbd=$KBD tablet=$TAB"
chmod 666 /dev/input/event* /dev/dri/* /dev/fb0 2>/dev/null

mkdir -p /run/dbus /run/user/1000 /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix
chown user:user /run/user/1000
chmod 700 /run/user/1000
dbus-uuidgen --ensure=/etc/machine-id
dbus-daemon --system --fork > /tmp/dbus.log 2>&1

# Start the desktop in the background so the serial shell still appears.
(
  /usr/bin/Xorg :0 vt1 -nolisten tcp -noreset > /tmp/xorg.out 2>&1 &
  i=0
  while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 900 ]; do sleep 1; i=$((i+1)); done
  echo "[rcS] X socket after ${i}s" > /dev/console
  runuser -u user -- /usr/local/bin/webqemu-session > /tmp/session.log 2>&1
) &
